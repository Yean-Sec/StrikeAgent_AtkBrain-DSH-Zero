{
  "name": "@local/atk-brain",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "StrikeAgent_AtkBrain-DSH-Zero — an authorized penetration-testing workbench for DeepSeek Harness.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/**/*.js",
    "assets/**/*",
    "test/**/*.js",
    "test/**/*.mjs",
    "test/**/*.py",
    "test/**/*.jsonl",
    "test/**/*.txt",
    "test/**/*.csv",
    "test/**/*.tsv",
    "test/**/*.json",
    "test/**/*.md",
    "test/fixtures/**/*.docx",
    "test/fixtures/**/*.xlsx",
    "test/fixtures/**/*.pptx",
    "locale/*.json",
    "icon.svg",
    "icon.png",
    "README.md",
    "LICENSE",
    "docs/*.png",
    "docs/assets/*",
    "scripts/**/*"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "dependencies": {
    "undici": "8.11.2"
  }
}
